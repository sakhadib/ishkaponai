{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The preload runs in the renderer process, so it has DOM access even
    // though it is bundled as CommonJS and sandboxed. It is kept in its own
    // project so that main-process code cannot accidentally reach for DOM APIs.
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["src/preload/**/*.ts", "src/shared/**/*.ts"]
}
